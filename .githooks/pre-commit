#!/bin/bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)

# Not `grep -q`: exiting early can SIGPIPE `git diff`, which pipefail would report as "no match".
if ! git diff --cached --name-only --diff-filter=ACMR | grep -E '\.swift$|(^|/)\.swiftlint\.yml$' >/dev/null; then
  exit 0
fi

echo "Running swiftlint..."
"$repo_root/scripts/lint.sh"
